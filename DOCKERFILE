
# === ЭТАП 1: Сборщик (Builder) ===
FROM python:3.12-slim AS builder

WORKDIR /build

# Устанавливаем системные инструменты компиляции
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Копируем файл зависимостей
COPY requirements.txt .

# Создаем wheel-пакеты библиотек
RUN pip wheel --no-cache-dir --wheel-dir=/build/wheels -r requirements.txt


# === ЭТАП 2: Финальный продакшен-образ ===
FROM python:3.12-slim

WORKDIR /app

# Копируем готовые библиотеки из Builder
COPY --from=builder /build/wheels /wheels
COPY --from=builder /build/requirements.txt .

# Устанавливаем зависимости
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r requirements.txt \
    && rm -rf /wheels

# Копируем ONNX-модель WineQT
COPY wine_quality_model.onnx .

# Копируем FastAPI-приложение
COPY main.py .

# Запускаем FastAPI-сервер
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
